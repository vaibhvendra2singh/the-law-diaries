# Copy this file to .env and fill in the values.
# Run `npm run setup` to generate ADMIN_EMAIL and ADMIN_PASSWORD_HASH.
# Run `openssl rand -base64 32` to generate NEXTAUTH_SECRET.

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

DATABASE_URL="file:./blog.db"
