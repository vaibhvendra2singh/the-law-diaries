{
  "name": "the-law-diaries",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "ts-node --project tsconfig.scripts.json scripts/setup.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node --project tsconfig.scripts.json prisma/seed.ts",
    "db:clear": "ts-node --project tsconfig.scripts.json scripts/clear_db.ts",
    "db:reset": "prisma migrate reset --force && ts-node --project tsconfig.scripts.json prisma/seed.ts"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18",
    "next-auth": "^4.24.7",
    "@prisma/client": "^5.15.0",
    "bcryptjs": "^2.4.3",
    "next-mdx-remote": "^5.0.0",
    "gray-matter": "^4.0.3",
    "reading-time": "^1.5.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "@uiw/react-md-editor": "^4.0.4",
    "resend": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5",
    "tailwindcss": "^3.4.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "prisma": "^5.15.0",
    "ts-node": "^10.9.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.5"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.scripts.json prisma/seed.ts"
  }
}
